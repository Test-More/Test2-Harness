#!/usr/bin/env perl
use v5.38;

use Config qw/%Config/;
use File::Path qw/make_path/;
use File::Basename qw/dirname/;
use Atomic::Pipe;
use IO::Select;

use Test2::Harness2::Collector qw/spawn_collector/;
use Test2::Harness2::Collector::Auditor;
use Test2::Harness2::Collector::Recorder::Test;
use Test2::Harness2::Collector::Monitor;
use Test2::Harness2::Util::IPC qw/atomic_pipe_compression_args/;
use Test2::Harness2::Util::JSON qw/encode_pretty_json/;
use Test2::Util::UUID qw/gen_uuid/;

# t2h2_collector - run one test file under the collector and report progress.
#
# Usage: t2h2_collector [-v] TEST_FILE EVENTS_FILE
#
# Three processes: this script, the collector it spawns (the middle process,
# which owns the recorder), and the test child the collector forks/execs. This
# script hands the recorder one end of an Atomic::Pipe and loops over the
# notification messages the recorder sends -- the start, each state
# transition, and the final result -- printing a basic line for each. With
# -v it also pretty-prints the full JSON payload of each message just after
# its line. The full event stream is written to EVENTS_FILE; the verdict comes
# over the pipe. Exits 0 (pass) or 1 (fail) from the collector's own
# verdict-derived exit.

my $verbose = @ARGV && $ARGV[0] eq '-v' ? shift @ARGV : 0;

my ($test_file, $events_file) = @ARGV;

die "Usage: $0 [-v] TEST_FILE EVENTS_FILE\n"
    unless defined $test_file && defined $events_file;

die "No such test file: $test_file\n" unless -f $test_file;

my $dir = dirname($events_file);
make_path($dir) unless -d $dir;

# The collected test runs with the stream formatter selected (is_test), so it
# needs this harness's libraries on its include path. Propagate our own @INC
# to the child so it can load them regardless of how we were invoked.
my $sep      = $Config{path_sep} || ':';
my $perl5lib = join($sep, grep { defined && length } @INC, $ENV{PERL5LIB});

my ($read, $write) = Atomic::Pipe->pair(atomic_pipe_compression_args());

# This runner handles a single test as its own one-off run, so the run_uuid
# and the collector's own uuid can be one and the same fresh uuid.
my $uuid = gen_uuid();

my $pid = spawn_collector(
    is_test   => 1,
    name      => $test_file,
    uuid      => $uuid,
    run_uuid  => $uuid,
    exec      => [$^X, $test_file],
    env       => {PERL5LIB => $perl5lib},
    processor => 'Test2::Harness2::Collector::Auditor',
    recorder  => Test2::Harness2::Collector::Recorder::Test->new(
        events_file => $events_file,
        pipes       => [$write],
    ),
);

# This process never writes; close our copy so the read end reaches EOF if the
# collector dies without a clean finalization.
$write->close;

my $monitor = Test2::Harness2::Collector::Monitor->new(pipe => $read);
my $select  = IO::Select->new($monitor->pipe->rh);

my $done = 0;
until ($done) {
    $select->can_read;    # block until there is something to read (or EOF)

    my @payloads = $monitor->poll;
    last unless @payloads;    # EOF: the collector closed the pipe

    for my $payload (@payloads) {
        my $fd = $payload->{facet_data};

        if (my $transition = $fd->{harness_state_transition}) {
            say "transition: $transition->{state}";
        }
        elsif (my $state = $fd->{harness_final_state}) {
            say "result: " . ($state->{pass} ? 'PASS' : 'FAIL');
        }

        print encode_pretty_json($payload) if $verbose;
    }

    $done = 1 if $monitor->new_finalized;
}

waitpid($pid, 0);
exit($? ? 1 : 0);
