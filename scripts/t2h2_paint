#!/usr/bin/env perl
use v5.38;

use Test2::Harness2::Util::Zstd qw/open_zstd_reader ZSTD_FRAME_MAGIC/;
use Test2::Harness2::Util::JSON qw/decode_json/;
use Test2::Util::Term qw/term_size/;

use App::Yath2::Renderer::Text::EventPainter;

# t2h2_paint - paint a collector events file as a human-readable graph.
#
# Usage: t2h2_paint [--color|--no-color] [-v] EVENTS_FILE
#
# Reads an events file (plain jsonl or multi-frame zstd, detected from the
# leading bytes rather than the name) and prints every event painted by
# App::Yath2::Renderer::Text::EventPainter: each renderable facet a graph-node
# row, subtests drawn as indented branches. Non-renderable events (harness
# lifecycle, etc.) produce no output. Color defaults on when STDOUT is a tty;
# -v shows verbose-only facets (plans, etc.).

my ($color, $verbosity, @rest);
for my $arg (@ARGV) {
    if    ($arg eq '--color')                  { $color     = 1 }
    elsif ($arg eq '--no-color')               { $color     = 0 }
    elsif ($arg eq '-v' || $arg eq '--verbose') { $verbosity = 2 }
    else                                       { push @rest, $arg }
}

my ($file) = @rest;
die "Usage: $0 [--color|--no-color] [-v] EVENTS_FILE\n" unless defined $file;
die "No such file: $file\n" unless -f $file;

$color     //= (-t STDOUT) ? 1 : 0;
$verbosity //= 1;

my $painter = App::Yath2::Renderer::Text::EventPainter->new(color => $color);
my $width   = term_size() || 80;

for my $event (_read_events($file)) {
    say for $painter->paint($event, verbosity => $verbosity, max_width => $width);
}

exit 0;

# Read the events file into a list of decoded event hashrefs, transparently
# decompressing when the leading bytes are a zstd frame magic.
sub _read_events ($path) {
    my @events;

    if (_is_zstd($path)) {
        my $reader = open_zstd_reader($path);
        while (defined(my $line = $reader->readline)) {
            chomp $line;
            push @events => decode_json($line) if length $line;
        }
        return @events;
    }

    open(my $fh, '<', $path) or die "open '$path': $!\n";
    while (my $line = <$fh>) {
        chomp $line;
        push @events => decode_json($line) if length $line;
    }
    return @events;
}

# True when the file begins with the zstd frame magic.
sub _is_zstd ($path) {
    open(my $fh, '<:raw', $path) or die "open '$path': $!\n";
    read($fh, my $head, length(ZSTD_FRAME_MAGIC));
    close($fh);
    return defined($head) && $head eq ZSTD_FRAME_MAGIC;
}
