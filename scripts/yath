#!/usr/bin/perl
use strict;
use warnings;

our $VERSION = '2.000011';

BEGIN {
    return if $^C;

    @INC = split /;/, $ENV{T2_HARNESS_INCLUDES} if $ENV{T2_HARNESS_INCLUDES};

    require App::Yath::Script;

    App::Yath::Script::do_begin();
}

exit(App::Yath::Script::do_runtime());

__END__

=pod

=encoding UTF-8

=head1 NAME

yath - launcher script for the yath test harness.

=head1 DESCRIPTION

This is the project-local C<yath> launcher. It delegates to
L<App::Yath::Script> (shipped by the C<App-Yath-Script>
distribution), which discovers C<.yath.rc> / C<.yath.user.rc>,
determines the harness version to run, and hands off to the
matching C<App::Yath::Script::V{X}> handler.

For V2 this repository ships L<App::Yath::Script::V2> (which in
turn drives L<App::Yath2>).

=head1 SOURCE

The source code repository for Test2-Harness can be found at
L<http://github.com/Test-More/Test2-Harness/>.

